+void SCREEN_INFORMATION::UpdatePrimaryAfterResize(const til::size size, const bool widthChanged, const bool hidden)
+{
+    // The shared state machine restores this position on 1049l. An earlier
+    // reduction still bounds it if the alternate grows before that return.
+    auto& engine = static_cast<OutputStateMachineEngine&>(GetStateMachine().Engine());
+    auto& dispatch = static_cast<AdaptDispatch&>(engine.Dispatch());
+    if (!hidden)
+    {
+        dispatch.ClampPrimaryCursorAfterAltReset(size);
+        return;
+    }
+    dispatch.ClampSavedPrimaryCursor(size, widthChanged);
+    if (widthChanged)
+    {
+        _fitWidthOnReturn = true;
+    }
+    // Apply height revisions now, retaining the main buffer's source columns.
+    // The active alternate already owns the requested viewport dimensions.
+    const til::size retained{ GetBufferSize().Width(), size.height };
+    SetViewportSize(&retained);
+    _deferredPtyResize = size;
+}
