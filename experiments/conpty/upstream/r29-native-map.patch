diff --git a/src/winconpty/winconpty.cpp b/src/winconpty/winconpty.cpp
--- a/src/winconpty/winconpty.cpp
+++ b/src/winconpty/winconpty.cpp
@@ -519,0 +520,16 @@
+// Send the same geometry request with a caller token used to identify the
+// ordered host-generated resize map in the output stream.
+extern "C" HRESULT WINAPI ConptyResizePseudoConsoleWithMap(_In_ HPCON hPC, _In_ COORD size, _In_reads_(16) const uint8_t* token)
+{
+    const auto pty = reinterpret_cast<const PseudoConsole*>(hPC);
+    if (!pty || !token || size.X < 1 || size.Y < 1 || size.X > 500 || size.Y > 200)
+    {
+        return E_INVALIDARG;
+    }
+
+    unsigned short packet[11]{ 9, static_cast<unsigned short>(size.X), static_cast<unsigned short>(size.Y) };
+    memcpy(packet + 3, token, 16);
+    return WriteFile(pty->hSignal, packet, sizeof(packet), nullptr, nullptr)
+        ? S_OK : HRESULT_FROM_WIN32(GetLastError());
+}
+
